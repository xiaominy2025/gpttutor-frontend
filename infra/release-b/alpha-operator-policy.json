{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnedChangeSets",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:GetTemplate",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DeleteStack",
        "cloudformation:ListStackResources"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:771049112957:stack/engent-release-b-alpha-routes/*",
        "arn:aws:cloudformation:us-east-1:771049112957:stack/engent-release-b-alpha-registration/*",
        "arn:aws:cloudformation:us-east-1:771049112957:changeSet/engent-release-b-alpha-*/*"
      ]
    },
    {
      "Sid": "AlphaRoutes",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/8qmgd1ghdi/routes",
        "arn:aws:apigateway:us-east-1::/apis/8qmgd1ghdi/routes/*"
      ]
    },
    {
      "Sid": "AlphaRouteRead",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-1::/apis/8qmgd1ghdi",
        "arn:aws:apigateway:us-east-1::/apis/8qmgd1ghdi/integrations/*"
      ]
    },
    {
      "Sid": "ExistingRuntimePolicyDelta",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::771049112957:role/engent-platform-alpha-runtime",
        "arn:aws:iam::771049112957:role/decisiontree-alpha-staging-ApiRole-tmQtkTYts533"
      ]
    },
    {
      "Sid": "ExistingTreeBoundaryVersions",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreatePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:DeletePolicyVersion"
      ],
      "Resource": "arn:aws:iam::771049112957:policy/decisiontree-alpha-staging-runtime-boundary"
    },
    {
      "Sid": "CreateBoundedGuardRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": "arn:aws:iam::771049112957:role/engent-release-a-alpha-registration-runtime",
      "Condition": {
        "ArnEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::771049112957:policy/engent-release-a-alpha-registration-boundary"
        }
      }
    },
    {
      "Sid": "GuardRoleLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:DeleteRole",
        "iam:GetRolePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": "arn:aws:iam::771049112957:role/engent-release-a-alpha-registration-runtime"
    },
    {
      "Sid": "GuardBoundaryLifecycle",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:DeletePolicy",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": "arn:aws:iam::771049112957:policy/engent-release-a-alpha-registration-boundary"
    },
    {
      "Sid": "GuardPassRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::771049112957:role/engent-release-a-alpha-registration-runtime",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ExistingAlphaVersions",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetAlias",
        "lambda:ListAliases",
        "lambda:ListVersionsByFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:UpdateAlias"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:771049112957:function:engent-platform-alpha-api",
        "arn:aws:lambda:us-east-1:771049112957:function:engent-platform-alpha-api:*",
        "arn:aws:lambda:us-east-1:771049112957:function:decisiontree-alpha-staging-api",
        "arn:aws:lambda:us-east-1:771049112957:function:decisiontree-alpha-staging-api:*"
      ]
    },
    {
      "Sid": "GuardFunctionLifecycle",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetPolicy",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:GetAlias",
        "lambda:DeleteAlias",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:771049112957:function:engent-release-a-alpha-registration",
        "arn:aws:lambda:us-east-1:771049112957:function:engent-release-a-alpha-registration:*"
      ]
    },
    {
      "Sid": "BoundedAlphaPoolConfiguration",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:DescribeUserPool",
        "cognito-idp:DescribeUserPoolClient",
        "cognito-idp:UpdateUserPool",
        "cognito-idp:ListUsers",
        "cognito-idp:AdminGetUser",
        "cognito-idp:AdminListGroupsForUser"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:771049112957:userpool/us-east-1_CipTwwDZb"
    },
    {
      "Sid": "ConditionalOwnedCanaryDeletion",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminDeleteUser"
      ],
      "Resource": "arn:aws:cognito-idp:us-east-1:771049112957:userpool/us-east-1_CipTwwDZb"
    },
    {
      "Sid": "RegistrationFlagOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:771049112957:table/decisiontree-alpha-staging-Data-JH4B4OFXWER5",
      "Condition": {
        "Null": {
          "dynamodb:LeadingKeys": "false"
        },
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "REGISTRATION#CONFIG"
          ]
        }
      }
    },
    {
      "Sid": "AlphaEdge",
      "Effect": "Allow",
      "Action": [
        "cloudfront:GetDistribution",
        "cloudfront:GetDistributionConfig",
        "cloudfront:UpdateDistribution"
      ],
      "Resource": "arn:aws:cloudfront::771049112957:distribution/E1C4AJI9FUE47B"
    },
    {
      "Sid": "ExistingViewerFunction",
      "Effect": "Allow",
      "Action": [
        "cloudfront:DescribeFunction",
        "cloudfront:GetFunction",
        "cloudfront:UpdateFunction",
        "cloudfront:PublishFunction",
        "cloudfront:TestFunction"
      ],
      "Resource": "arn:aws:cloudfront::771049112957:function/engent-release-a-alpha-explore"
    },
    {
      "Sid": "ImmutableArtifactUpload",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::decisiontree-alpha-artifacts-771049112957-us-east-1/engent-release-a-alpha/registration-guard/*",
        "arn:aws:s3:::decisiontree-alpha-artifacts-771049112957-us-east-1/engent-release-b-alpha/*",
        "arn:aws:s3:::decisiontree-alpha-staging-frontend-vnhhrwadnpad/releases/engent-release-b-alpha/*"
      ]
    },
    {
      "Sid": "ArtifactVersioningRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::decisiontree-alpha-artifacts-771049112957-us-east-1",
        "arn:aws:s3:::decisiontree-alpha-staging-frontend-vnhhrwadnpad"
      ]
    },
    {
      "Sid": "RetainedGuardLogRead",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SignedAlphaRouteVerification",
      "Effect": "Allow",
      "Action": "execute-api:Invoke",
      "Resource": [
        "arn:aws:execute-api:us-east-1:771049112957:8qmgd1ghdi/$default/POST/internal/platform/email/start",
        "arn:aws:execute-api:us-east-1:771049112957:8qmgd1ghdi/$default/POST/internal/platform/email/finish",
        "arn:aws:execute-api:us-east-1:771049112957:8qmgd1ghdi/$default/POST/internal/platform/email/session",
        "arn:aws:execute-api:us-east-1:771049112957:8qmgd1ghdi/$default/POST/internal/platform/email/handoff",
        "arn:aws:execute-api:us-east-1:771049112957:8qmgd1ghdi/$default/POST/internal/platform/email/advanced-request"
      ]
    },
    {
      "Sid": "GuardPreconditionInvocation",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-east-1:771049112957:function:engent-release-a-alpha-registration:live"
    },
    {
      "Sid": "ReadOnlyCustomPolicySimulation",
      "Effect": "Allow",
      "Action": "iam:SimulateCustomPolicy",
      "Resource": "*"
    }
  ]
}
